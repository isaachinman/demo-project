{
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@demo-project/*": ["./src/*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["node", "vite/client", "vitest/globals"],
    "verbatimModuleSyntax": true
  },
  "include": ["src", ".railway", "drizzle.config.ts", "vite.config.ts", "vitest.config.ts"]
}
