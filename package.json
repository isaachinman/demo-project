{
  "name": "demo-project",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "docker compose up -d --wait db redis && concurrently --kill-others-on-fail --names server,worker,web --prefix-colors blue,magenta,green \"bun run dev:server\" \"bun run dev:worker\" \"bun run dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker/index.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "start:server": "node dist/app/server/index.js",
    "start:worker": "node dist/app/worker/index.js",
    "init": "node dist/app/scripts/init.js",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsr generate && tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build:app": "esbuild src/server/index.ts src/worker/index.ts src/scripts/init.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outbase=src --outdir=dist/app",
    "build": "bun run build:app && bun run build:web"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "2.73.0",
    "@hono/node-server": "2.1.1",
    "@openrouter/sdk": "1.4.25",
    "@tanstack/react-router": "1.170.36",
    "@untitledui/icons": "0.0.22",
    "@valibot/to-json-schema": "1.8.0",
    "bullmq": "5.81.5",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "ioredis": "5.11.1",
    "motion": "14.3.0",
    "pg": "8.23.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.13",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.36",
    "@tanstack/router-plugin": "1.168.38",
    "@types/node": "26.5.1",
    "@types/pg": "8.23.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.10",
    "encephalon": "0.5.0",
    "esbuild": "0.28.2",
    "railway": "3.15.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "6.0.1",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
